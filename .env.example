# Copy to .env and fill in. Never commit .env.
FLASK_CONFIG=development
SECRET_KEY=change-me-to-a-long-random-string
OTP_SECRET=another-long-random-string

# Database — leave empty for a local SQLite file.
# Cloud Postgres (Supabase: Project → Connect → "Session pooler" URI), paste as-is:
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
# MySQL:
# DATABASE_URL=mysql+pymysql://sweetshop:password@localhost:3306/sweetshop?charset=utf8mb4
DATABASE_URL=

# Store details printed on invoices and emails
STORE_NAME=Shree Mithai Mahal
STORE_TAGLINE=Pure Ghee Sweets & Savouries since 1987
STORE_ADDRESS=214 Diwali Market Street, Edison, NJ 08820
STORE_PHONE=+1 (732) 555-0142
STORE_EMAIL=orders@shreemithaimahal.example
SUPPORT_EMAIL=support@shreemithaimahal.example
STORE_GSTIN=
STORE_TIMEZONE=America/Chicago
CURRENCY=usd
CURRENCY_SYMBOL=$
TAX_RATE=0.05
TAX_LABEL=GST 5%
DELIVERY_CHARGE=4.99
FREE_DELIVERY_ABOVE=50

# SMTP — leave MAIL_SERVER empty to write emails to instance/outbox/ instead.
# Gmail: smtp.gmail.com, port 587, TLS, and an App Password (not your normal password).
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=Shree Mithai Mahal <orders@shreemithaimahal.example>

# Shows the OTP on screen in development when SMTP is not configured. Never enable in production.
SHOW_DEV_OTP=true

# Payments: "simulated" (built-in test gateway, no keys) or "stripe" (test-mode keys)
PAYMENT_GATEWAY=simulated
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=
ENABLE_COD=true

# Seed admin account (used by scripts/init_db.py / flask seed)
ADMIN_EMAIL=admin@sweetshop.local
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Shop Admin
